<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="theme-color" content="#111111">

  <meta name="description"
        content="CITY KART Barharwa — Fashion, ethnic wear, wedding collection, festive collection, men's, women's and kids' fashion.">

  <title>CITY KART | Barharwa</title>

  <style>
    /* =========================================================
       CITY KART — GRAND MASTER WEBSITE
       All CSS is inside this file.
       ========================================================= */

    :root{
      --black:#0b0b0b;
      --black2:#141414;
      --dark:#1d1d1d;
      --gold:#c9a45c;
      --gold2:#e5c982;
      --cream:#f7f2e8;
      --white:#ffffff;
      --muted:#777;
      --line:#e7e2d8;
      --soft:#faf8f3;
      --success:#25d366;
      --shadow:0 20px 60px rgba(0,0,0,.12);
      --radius:22px;
      --max:1280px;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:var(--white);
      color:var(--black);
      line-height:1.6;
      overflow-x:hidden;
    }

    img{
      max-width:100%;
      display:block;
    }

    a{
      color:inherit;
      text-decoration:none;
    }

    button,
    input,
    textarea,
    select{
      font:inherit;
    }

    button{
      cursor:pointer;
    }

    .container{
      width:min(92%,var(--max));
      margin:auto;
    }

    /* =========================================================
       PRELOADER
       ========================================================= */

    #loader{
      position:fixed;
      inset:0;
      background:var(--black);
      z-index:99999;
      display:flex;
      align-items:center;
      justify-content:center;
      transition:.6s ease;
    }

    .loader-box{
      text-align:center;
      color:white;
    }

    .loader-logo{
      font-size:42px;
      letter-spacing:8px;
      font-weight:900;
    }

    .loader-sub{
      color:var(--gold2);
      letter-spacing:4px;
      margin-top:8px;
      font-size:12px;
    }

    .loader-line{
      width:180px;
      height:2px;
      background:#333;
      margin:25px auto 0;
      overflow:hidden;
    }

    .loader-line span{
      display:block;
      height:100%;
      width:45%;
      background:var(--gold);
      animation:loading 1.2s infinite ease-in-out;
    }

    @keyframes loading{
      0%{transform:translateX(-180px)}
      100%{transform:translateX(220px)}
    }

    /* =========================================================
       TOP BAR
       ========================================================= */

    .topbar{
      background:var(--black);
      color:white;
      min-height:38px;
      display:flex;
      align-items:center;
      font-size:12px;
      letter-spacing:.5px;
    }

    .topbar-inner{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
    }

    .topbar-left,
    .topbar-right{
      display:flex;
      gap:20px;
      align-items:center;
    }

    .gold{
      color:var(--gold2);
    }

    /* =========================================================
       HEADER
       ========================================================= */

    header{
      position:sticky;
      top:0;
      z-index:5000;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(15px);
      border-bottom:1px solid rgba(0,0,0,.08);
    }

    .nav{
      min-height:78px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:30px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      min-width:max-content;
    }

    .brand-mark{
      width:46px;
      height:46px;
      background:var(--black);
      color:var(--gold2);
      display:grid;
      place-items:center;
      font-weight:900;
      border-radius:12px;
      letter-spacing:-1px;
    }

    .brand-name{
      font-size:23px;
      font-weight:900;
      letter-spacing:2px;
    }

    .brand-place{
      display:block;
      color:#888;
      font-size:10px;
      letter-spacing:3px;
      margin-top:-2px;
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:26px;
      list-style:none;
    }

    .nav-links a{
      font-size:13px;
      font-weight:700;
      position:relative;
      padding:10px 0;
    }

    .nav-links a::after{
      content:"";
      position:absolute;
      left:0;
      bottom:2px;
      width:0;
      height:2px;
      background:var(--gold);
      transition:.3s;
    }

    .nav-links a:hover::after{
      width:100%;
    }

    .nav-actions{
      display:flex;
      gap:9px;
      align-items:center;
    }

    .icon-btn{
      width:43px;
      height:43px;
      border:1px solid #ddd;
      background:white;
      border-radius:50%;
      display:grid;
      place-items:center;
      transition:.3s;
      font-size:17px;
    }

    .icon-btn:hover{
      background:var(--black);
      color:white;
      border-color:var(--black);
      transform:translateY(-2px);
    }

    .menu-btn{
      display:none;
    }

    /* =========================================================
       HERO
       ========================================================= */

    .hero{
      min-height:720px;
      background:
        radial-gradient(circle at 80% 25%,rgba(201,164,92,.28),transparent 25%),
        linear-gradient(115deg,#090909 0%,#151515 52%,#27221a 100%);
      color:white;
      position:relative;
      overflow:hidden;
      display:flex;
      align-items:center;
    }

    .hero::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(90deg,rgba(0,0,0,.75),rgba(0,0,0,.18)),
        repeating-linear-gradient(
          45deg,
          transparent 0,
          transparent 18px,
          rgba(255,255,255,.015) 19px,
          transparent 20px
        );
    }

    .hero-content{
      position:relative;
      z-index:2;
      padding:90px 0;
      max-width:760px;
    }

    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:10px;
      color:var(--gold2);
      letter-spacing:5px;
      font-size:12px;
      font-weight:800;
      text-transform:uppercase;
      margin-bottom:20px;
    }

    .eyebrow::before{
      content:"";
      width:35px;
      height:1px;
      background:var(--gold2);
    }

    .hero h1{
      font-size:clamp(52px,8vw,110px);
      line-height:.88;
      letter-spacing:-5px;
      margin-bottom:25px;
      font-weight:950;
    }

    .hero h1 span{
      color:var(--gold2);
    }

    .hero p{
      max-width:650px;
      color:#ddd;
      font-size:18px;
      margin-bottom:32px;
    }

    .hero-buttons{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
    }

    .btn{
      border:0;
      padding:15px 24px;
      border-radius:999px;
      font-weight:800;
      display:inline-flex;
      justify-content:center;
      align-items:center;
      gap:9px;
      transition:.3s;
    }

    .btn-gold{
      background:var(--gold2);
      color:#111;
    }

    .btn-gold:hover{
      transform:translateY(-3px);
      box-shadow:0 15px 30px rgba(201,164,92,.2);
    }

    .btn-outline{
      background:transparent;
      color:white;
      border:1px solid rgba(255,255,255,.35);
    }

    .btn-outline:hover{
      background:white;
      color:#111;
    }

    .hero-badge{
      position:absolute;
      right:7%;
      bottom:12%;
      width:180px;
      height:180px;
      border:1px solid rgba(229,201,130,.55);
      border-radius:50%;
      display:grid;
      place-items:center;
      text-align:center;
      transform:rotate(-10deg);
      color:var(--gold2);
      font-size:12px;
      letter-spacing:3px;
      line-height:1.5;
    }

    .hero-badge strong{
      display:block;
      font-size:25px;
      color:white;
      letter-spacing:1px;
    }

    /* =========================================================
       QUICK FEATURES
       ========================================================= */

    .feature-strip{
      background:white;
      box-shadow:0 10px 40px rgba(0,0,0,.07);
      position:relative;
      z-index:4;
      margin-top:-45px;
      border-radius:24px;
    }

    .features{
      display:grid;
      grid-template-columns:repeat(4,1fr);
    }

    .feature{
      padding:28px 22px;
      display:flex;
      gap:14px;
      align-items:flex-start;
      border-right:1px solid #eee;
    }

    .feature:last-child{
      border-right:0;
    }

    .feature-icon{
      font-size:27px;
    }

    .feature h3{
      font-size:14px;
      margin-bottom:4px;
    }

    .feature p{
      color:#777;
      font-size:12px;
    }

    /* =========================================================
       SECTION HEADINGS
       ========================================================= */

    section{
      padding:100px 0;
    }

    .section-head{
      display:flex;
      justify-content:space-between;
      align-items:end;
      gap:25px;
      margin-bottom:45px;
    }

    .section-kicker{
      color:#a6813f;
      text-transform:uppercase;
      letter-spacing:4px;
      font-size:11px;
      font-weight:900;
      margin-bottom:10px;
    }

    .section-title{
      font-size:clamp(32px,4vw,54px);
      line-height:1;
      letter-spacing:-2px;
    }

    .section-description{
      color:#777;
      max-width:530px;
      font-size:15px;
    }

    /* =========================================================
       COLLECTIONS
       ========================================================= */

    .collections{
      background:var(--soft);
    }

    .collection-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:18px;
    }

    .collection-card{
      min-height:330px;
      border-radius:22px;
      overflow:hidden;
      position:relative;
      background:
        linear-gradient(145deg,#222,#777);
      isolation:isolate;
      transition:.45s;
    }

    .collection-card:nth-child(2){
      background:linear-gradient(145deg,#5c4530,#c5a87b);
    }

    .collection-card:nth-child(3){
      background:linear-gradient(145deg,#292b31,#7c8089);
    }

    .collection-card:nth-child(4){
      background:linear-gradient(145deg,#332016,#b68148);
    }

    .collection-card::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        radial-gradient(circle at 70% 25%,rgba(255,255,255,.25),transparent 22%),
        linear-gradient(to top,rgba(0,0,0,.82),transparent 65%);
      z-index:-1;
    }

    .collection-card:hover{
      transform:translateY(-8px);
      box-shadow:var(--shadow);
    }

    .collection-number{
      position:absolute;
      right:20px;
      top:15px;
      color:rgba(255,255,255,.35);
      font-size:45px;
      font-weight:900;
    }

    .collection-content{
      position:absolute;
      left:24px;
      right:24px;
      bottom:25px;
      color:white;
    }

    .collection-content small{
      color:var(--gold2);
      text-transform:uppercase;
      letter-spacing:3px;
    }

    .collection-content h3{
      font-size:29px;
      margin:5px 0;
    }

    .collection-link{
      font-size:12px;
      color:#ddd;
    }

    /* =========================================================
       CATALOGUE
       ========================================================= */

    .catalogue{
      background:white;
    }

    .catalogue-toolbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:15px;
      margin-bottom:28px;
      flex-wrap:wrap;
    }

    .filters{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .filter-btn{
      border:1px solid #ddd;
      background:white;
      padding:10px 17px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      transition:.3s;
    }

    .filter-btn:hover,
    .filter-btn.active{
      background:var(--black);
      color:white;
      border-color:var(--black);
    }

    .search-box{
      width:min(100%,280px);
      position:relative;
    }

    .search-box input{
      width:100%;
      border:1px solid #ddd;
      padding:12px 17px;
      border-radius:999px;
      outline:0;
    }

    .search-box input:focus{
      border-color:var(--gold);
    }

    .products-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:20px;
    }

    .product-card{
      border:1px solid #eee;
      border-radius:20px;
      overflow:hidden;
      background:white;
      transition:.35s;
    }

    .product-card:hover{
      transform:translateY(-6px);
      box-shadow:var(--shadow);
    }

    .product-visual{
      height:280px;
      position:relative;
      overflow:hidden;
      display:flex;
      align-items:flex-end;
      justify-content:center;
      background:
        radial-gradient(circle at 50% 25%,rgba(255,255,255,.45),transparent 25%),
        linear-gradient(145deg,#ece7dd,#b5aa99);
    }

    .product-card:nth-child(3n) .product-visual{
      background:linear-gradient(145deg,#ddd8d0,#89847c);
    }

    .product-card:nth-child(4n) .product-visual{
      background:linear-gradient(145deg,#d5c0a3,#705c45);
    }

    .product-card:nth-child(5n) .product-visual{
      background:linear-gradient(145deg,#202020,#5d5d5d);
    }

    .product-symbol{
      font-size:105px;
      filter:drop-shadow(0 18px 12px rgba(0,0,0,.15));
      margin-bottom:20px;
      transition:.4s;
    }

    .product-card:hover .product-symbol{
      transform:scale(1.08) translateY(-6px);
    }

    .product-tag{
      position:absolute;
      top:14px;
      left:14px;
      background:var(--black);
      color:white;
      padding:6px 10px;
      border-radius:999px;
      font-size:9px;
      font-weight:900;
      letter-spacing:1px;
    }

    .product-info{
      padding:18px;
    }

    .product-category{
      color:#9c7b43;
      font-size:10px;
      letter-spacing:2px;
      text-transform:uppercase;
      font-weight:900;
    }

    .product-info h3{
      font-size:18px;
      margin:5px 0;
    }

    .product-info p{
      color:#777;
      font-size:12px;
      min-height:38px;
    }

    .product-bottom{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-top:15px;
    }

    .enquire-btn{
      border:0;
      background:var(--black);
      color:white;
      border-radius:999px;
      padding:9px 13px;
      font-size:11px;
      font-weight:800;
    }

    .details-btn{
      background:transparent;
      border:0;
      color:#777;
      font-size:11px;
      font-weight:800;
    }

    .no-products{
      grid-column:1/-1;
      text-align:center;
      padding:50px;
      color:#777;
      display:none;
    }

    /* =========================================================
       FEATURED DARK SECTION
       ========================================================= */

    .dark-section{
      background:var(--black);
      color:white;
      position:relative;
      overflow:hidden;
    }

    .dark-section::after{
      content:"CITY KART";
      position:absolute;
      right:-30px;
      bottom:-50px;
      font-size:150px;
      font-weight:900;
      color:rgba(255,255,255,.025);
      pointer-events:none;
    }

    .dark-section .section-description{
      color:#aaa;
    }

    .feature-grid{
      display:grid;
      grid-template-columns:1.4fr 1fr 1fr;
      gap:18px;
    }

    .feature-panel{
      min-height:390px;
      border-radius:24px;
      overflow:hidden;
      position:relative;
      background:linear-gradient(145deg,#1f1f1f,#4d4030);
      padding:30px;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      transition:.4s;
    }

    .feature-panel:nth-child(2){
      background:linear-gradient(145deg,#272727,#75624b);
    }

    .feature-panel:nth-child(3){
      background:linear-gradient(145deg,#171717,#464646);
    }

    .feature-panel:hover{
      transform:translateY(-7px);
    }

    .feature-panel span{
      color:var(--gold2);
      font-size:11px;
      letter-spacing:3px;
      font-weight:800;
    }

    .feature-panel h3{
      font-size:34px;
      line-height:1;
      margin:8px 0;
    }

    .feature-panel p{
      color:#ddd;
      font-size:13px;
      max-width:360px;
    }

    /* =========================================================
       WHY CITY KART
       ========================================================= */

    .why-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .why-card{
      border:1px solid var(--line);
      padding:30px;
      border-radius:22px;
      transition:.3s;
    }

    .why-card:hover{
      border-color:var(--gold);
      transform:translateY(-5px);
    }

    .why-number{
      font-size:13px;
      color:var(--gold);
      font-weight:900;
    }

    .why-icon{
      font-size:35px;
      margin:18px 0;
    }

    .why-card h3{
      font-size:20px;
      margin-bottom:8px;
    }

    .why-card p{
      color:#777;
      font-size:13px;
    }

    /* =========================================================
       SHOWROOM
       ========================================================= */

    .showroom{
      background:var(--soft);
    }

    .showroom-grid{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:30px;
      align-items:stretch;
    }

    .showroom-main{
      min-height:520px;
      border-radius:28px;
      overflow:hidden;
      background:
        linear-gradient(to top,rgba(0,0,0,.75),transparent 55%),
        linear-gradient(145deg,#2b2b2b,#b69b70);
      position:relative;
      display:flex;
      align-items:flex-end;
      padding:35px;
      color:white;
    }

    .showroom-main h3{
      font-size:42px;
      line-height:1;
      max-width:500px;
    }

    .showroom-side{
      display:grid;
      grid-template-rows:1fr 1fr;
      gap:20px;
    }

    .showroom-small{
      border-radius:24px;
      padding:30px;
      color:white;
      min-height:240px;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      background:
        linear-gradient(to top,rgba(0,0,0,.7),transparent),
        linear-gradient(145deg,#6b5a47,#d5c1a0);
    }

    .showroom-small:nth-child(2){
      background:
        linear-gradient(to top,rgba(0,0,0,.75),transparent),
        linear-gradient(145deg,#252525,#777);
    }

    .showroom-small h3{
      font-size:25px;
    }

    .photo-note{
      margin-top:22px;
      padding:14px 18px;
      border:1px dashed #cfc8bb;
      border-radius:14px;
      color:#777;
      font-size:12px;
      background:white;
    }

    /* =========================================================
       STATS
       ========================================================= */

    .stats{
      background:var(--black);
      color:white;
      padding:65px 0;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:20px;
    }

    .stat{
      text-align:center;
      padding:15px;
      border-right:1px solid #333;
    }

    .stat:last-child{
      border-right:0;
    }

    .stat strong{
      font-size:45px;
      display:block;
      color:var(--gold2);
    }

    .stat span{
      color:#aaa;
      font-size:12px;
      letter-spacing:1px;
    }

    /* =========================================================
       SERVICES
       ========================================================= */

    .service-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:18px;
    }

    .service-card{
      padding:28px;
      background:var(--soft);
      border-radius:20px;
      transition:.3s;
    }

    .service-card:hover{
  transform:translateY(-8px);
  box-shadow:var(--shadow);
}

.service-icon{
  width:58px;
  height:58px;
  border-radius:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--dark);
  color:#fff;
  font-size:24px;
  margin-bottom:18px;
}

.service-card h3{
  margin:0 0 10px;
  font-size:20px;
}

.service-card p{
  margin:0;
  color:var(--muted);
  line-height:1.7;
}

/* =========================
   REVIEWS
========================= */

.reviews{
  background:var(--soft);
}

.review-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.review-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:22px;
  padding:26px;
  transition:.3s;
}

.review-card:hover{
  transform:translateY(-6px);
  box-shadow:var(--shadow);
}

.stars{
  color:#d39a28;
  letter-spacing:2px;
  margin-bottom:15px;
}

.review-card p{
  color:var(--muted);
  line-height:1.8;
  margin:0 0 18px;
}

.reviewer{
  display:flex;
  align-items:center;
  gap:12px;
}

.reviewer-avatar{
  width:46px;
  height:46px;
  border-radius:50%;
  background:var(--dark);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
}

.reviewer strong{
  display:block;
  margin-bottom:3px;
}

.reviewer span{
  color:var(--muted);
  font-size:13px;
}

/* =========================
   FAQ
========================= */

.faq{
  max-width:900px;
  margin:auto;
}

.faq-item{
  border:1px solid var(--border);
  border-radius:18px;
  margin-bottom:14px;
  overflow:hidden;
  background:#fff;
}

.faq-question{
